#!/usr/bin/env bash
set -euo pipefail

SCRIPT_VERSION="1.1.0"
SCRIPT_NAME="$(basename "$0")"
APP_NAME=""
EXE_PATH=""
WINEPREFIX_BASE="${HOME}/.local/share/wine-apps"
ICON_BASE="${HOME}/.local/share/icons/wine-apps"
DESKTOP_BASE="${HOME}/.local/share/applications"
LOG_DIR="${HOME}/.local/share/wine-apps/logs"
DEFAULT_VERBS="corefonts vcrun2019 wine-mono wine-gecko"
INSTALL_ICON=true
CREATE_DESKTOP=true
USE_DXVK=false
FIX_WINDOW=false
WINEARCH_OVERRIDE=""
LOG_FILE=""

if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
    BLUE='\033[0;34m'; BOLD='\033[1m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; BOLD=''; NC=''
fi

log()  { echo -e "$*" | tee -a "$LOG_FILE"; }
info() { log "${GREEN}[INFO]${NC} $*"; }
warn() { log "${YELLOW}[WARN]${NC} $*"; }
error(){ log "${RED}[ERROR]${NC} $*" >&2; }
step() { log "\n${BLUE}${BOLD}▶ $*${NC}"; }

cleanup() {
    local code=$?
    if [[ $code -ne 0 ]]; then
        error "El script falló con código $code. Revisa el log: $LOG_FILE"
    fi
}
trap cleanup EXIT

usage() {
    cat <<EOF
${BOLD}wine-exe-installer v${SCRIPT_VERSION}${NC}

Uso: $SCRIPT_NAME [OPCIONES] <nombre-app> <ruta/al/instalador.exe>

Opciones:
  -h, --help              Muestra esta ayuda
  -v, --version           Muestra la versión
  --no-icon               No extraer icono del .exe
  --no-desktop            No crear archivo .desktop
  --dxvk                  Instalar DXVK
  --fix-window            Desactiva decoración/control del gestor de ventanas
  --arch=win32|win64      Forzar arquitectura del prefijo
  --verbs "v1 v2 ..."     Verbos de winetricks (por defecto: "$DEFAULT_VERBS")

Ejemplos:
  $SCRIPT_NAME mi-app ~/Descargas/setup.exe
  $SCRIPT_NAME juego ~/Descargas/juego.exe --dxvk
  $SCRIPT_NAME capcut ~/Descargas/CapCut.exe --fix-window
EOF
    exit 0
}

POSITIONAL=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)       usage ;;
        -v|--version)    echo "$SCRIPT_NAME v$SCRIPT_VERSION"; exit 0 ;;
        --no-icon)       INSTALL_ICON=false; shift ;;
        --no-desktop)    CREATE_DESKTOP=false; shift ;;
        --dxvk)          USE_DXVK=true; shift ;;
        --fix-window)    FIX_WINDOW=true; shift ;;
        --arch=*)        WINEARCH_OVERRIDE="${1#*=}"; shift ;;
        --verbs)         DEFAULT_VERBS="$2"; shift 2 ;;
        -*)              error "Opción desconocida: $1"; usage ;;
        *)               POSITIONAL+=("$1"); shift ;;
    esac
done

set -- "${POSITIONAL[@]}"

if [[ $# -lt 2 ]]; then
    error "Faltan argumentos. Usa -h para ver la ayuda."
    exit 1
fi

APP_NAME="$1"
EXE_PATH="$(realpath "$2")"

if [[ ! "$APP_NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    error "Nombre de app inválido: '$APP_NAME'."
    exit 1
fi

if [[ ! -f "$EXE_PATH" ]]; then
    error "No se encuentra el archivo: $EXE_PATH"
    exit 1
fi

if [[ ! "$EXE_PATH" =~ \.exe$ ]]; then
    warn "El archivo no termina en .exe. Se intentará ejecutar igualmente."
fi

mkdir -p "$LOG_DIR"
LOG_FILE="${LOG_DIR}/${APP_NAME}-$(date +%Y%m%d-%H%M%S).log"
touch "$LOG_FILE"
info "Log: $LOG_FILE"

step "Verificando dependencias"
MISSING=()
for cmd in wine wineboot winetricks wrestool icotool convert; do
    command -v "$cmd" &>/dev/null || MISSING+=("$cmd")
done

HAS_NOTIFY=false
command -v notify-send &>/dev/null && HAS_NOTIFY=true

if [[ ${#MISSING[@]} -gt 0 ]]; then
    error "Faltan dependencias: ${MISSING[*]}"
    cat <<EOF

Instálalas según tu distribución:
  Debian/Ubuntu:  sudo apt install wine winetricks icoutils imagemagick
  Arch:           sudo pacman -S wine winetricks icoutils imagemagick
  Fedora:         sudo dnf install wine winetricks icoutils ImageMagick
  openSUSE:       sudo zypper install wine winetricks icoutils ImageMagick

EOF
    exit 1
fi
info "Todas las dependencias presentes."

step "Detectando arquitectura"
if [[ -n "$WINEARCH_OVERRIDE" ]]; then
    WINEARCH="$WINEARCH_OVERRIDE"
    info "Arquitectura forzada: $WINEARCH"
else
    if file "$EXE_PATH" | grep -q "PE32+"; then
        WINEARCH="win64"
    elif file "$EXE_PATH" | grep -q "PE32 executable"; then
        WINEARCH="win64"
    else
        WINEARCH="win64"
    fi
    info "Arquitectura detectada: $WINEARCH"
fi

PREFIX_DIR="${WINEPREFIX_BASE}/${APP_NAME}"
step "Preparando prefijo aislado"
info "Ruta: $PREFIX_DIR"

if [[ -d "$PREFIX_DIR/drive_c" ]]; then
    warn "El prefijo ya existe. Se reutilizará."
else
    mkdir -p "$PREFIX_DIR"
fi

export WINEPREFIX="$PREFIX_DIR"
export WINEARCH
export WINEDEBUG="-all"

if [[ ! -d "$WINEPREFIX/drive_c" ]]; then
    info "Inicializando Wine..."
    wineboot --init &>>"$LOG_FILE" || {
        error "wineboot falló. Revisa el log."
        exit 1
    }
    wineserver -w &>/dev/null || true
fi

if [[ "$FIX_WINDOW" == true ]]; then
    step "Aplicando fix de gestor de ventanas"
    info "Desactivando decoración y control del gestor de ventanas..."
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine\\X11 Driver" /v Decorated /t REG_SZ /d "N" /f &>>"$LOG_FILE" || \
        warn "No se pudo modificar Decorated."
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine\\X11 Driver" /v Managed /t REG_SZ /d "N" /f &>>"$LOG_FILE" || \
        warn "No se pudo modificar Managed."
    info "Fix de ventana aplicado."
fi

step "Verificando soporte ntsync"
if [[ -e /dev/ntsync ]]; then
    info "ntsync disponible (/dev/ntsync)."
else
    info "ntsync no disponible."
fi

step "Instalando dependencias de Windows"
VERBS_TO_INSTALL="$DEFAULT_VERBS"
[[ "$USE_DXVK" == true ]] && VERBS_TO_INSTALL="$VERBS_TO_INSTALL dxvk"

for verb in $VERBS_TO_INSTALL; do
    info "  → $verb"
    if ! winetricks -q "$verb" &>>"$LOG_FILE"; then
        warn "No se pudo instalar '$verb'."
    fi
done

step "Ejecutando instalador"
info "Archivo: $EXE_PATH"
info "Sigue las instrucciones del instalador de Windows."

if ! wine "$EXE_PATH" &>>"$LOG_FILE"; then
    error "El instalador devolvió un error. Revisa el log: $LOG_FILE"
    exit 1
fi

wineserver -w &>/dev/null || true

step "Buscando ejecutable principal"
INSTALLED_EXE=""
SEARCH_DIRS=(
    "${WINEPREFIX}/drive_c/Program Files"
    "${WINEPREFIX}/drive_c/Program Files (x86)"
)

CANDIDATES=""
for dir in "${SEARCH_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    while IFS= read -r f; do
        CANDIDATES+="$f"$'\n'
    done < <(find "$dir" -iname "*.exe" -type f 2>/dev/null \
        | grep -viE "unins|setup|install|update|crash|report" || true)
done

CANDIDATES="$(echo "$CANDIDATES" | sed '/^$/d')"

if [[ -n "$CANDIDATES" ]]; then
    INSTALLED_EXE=$(echo "$CANDIDATES" | xargs -d '\n' ls -t 2>/dev/null | head -1 || echo "$CANDIDATES" | head -1)
    info "Ejecutable detectado: $INSTALLED_EXE"
else
    warn "No se detectó automáticamente el ejecutable."
    read -rp "Ruta completa del .exe dentro del prefijo (vacío para omitir): " INSTALLED_EXE
fi

step "Guardando receta del prefijo"
RECIPE_FILE="${WINEPREFIX}/prefix-recipe.txt"
cat > "$RECIPE_FILE" <<EOF
APP_NAME="${APP_NAME}"
WINEARCH="${WINEARCH}"
WINEPREFIX="${WINEPREFIX}"
INSTALLED_EXE="${INSTALLED_EXE}"
WINETRICKS_VERBS="${VERBS_TO_INSTALL}"
FIX_WINDOW="${FIX_WINDOW}"
USE_DXVK="${USE_DXVK}"
WINE_VERSION="$(wine --version 2>/dev/null || echo 'desconocida')"
GENERATED_BY="wine-exe-installer v${SCRIPT_VERSION}"
DATE="$(date -Iseconds)"
EOF
info "Receta guardada en: $RECIPE_FILE"

ICON_PATH=""
if [[ "$INSTALL_ICON" == true && -n "$INSTALLED_EXE" && -f "$INSTALLED_EXE" ]]; then
    step "Extrayendo icono"
    mkdir -p "$ICON_BASE"
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT

    if wrestool -x -o "$TMP" "$INSTALLED_EXE" &>>"$LOG_FILE"; then
        ICO=$(find "$TMP" -iname "*.ico" | head -1 || true)
        if [[ -n "$ICO" ]]; then
            icotool -x -o "$TMP" "$ICO" &>>"$LOG_FILE" || true
            PNG=$(find "$TMP" -iname "*.png" -type f -printf "%s %p\n" 2>/dev/null \
                | sort -rn | head -1 | awk '{print $2}' || true)
            if [[ -n "$PNG" ]]; then
                ICON_PATH="${ICON_BASE}/${APP_NAME}.png"
                convert "$PNG" -resize 256x256 "$ICON_PATH" &>>"$LOG_FILE" \
                    || cp "$PNG" "$ICON_PATH"
                info "Icono: $ICON_PATH"
            fi
        fi
    fi
fi

[[ -z "$ICON_PATH" ]] && ICON_PATH="wine"

DESKTOP_FILE=""
if [[ "$CREATE_DESKTOP" == true && -n "$INSTALLED_EXE" ]]; then
    step "Creando lanzador .desktop"
    mkdir -p "$DESKTOP_BASE"
    DESKTOP_FILE="${DESKTOP_BASE}/${APP_NAME}.desktop"

    cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.5
Type=Application
Name=${APP_NAME}
Comment=Aplicación Windows ejecutada con Wine
Exec=env WINEPREFIX="${WINEPREFIX}" WINEDEBUG="-all" wine "${INSTALLED_EXE}"
Icon=${ICON_PATH}
Terminal=false
Categories=Wine;Utility;
StartupNotify=true
StartupWMClass=${APP_NAME}
EOF

    chmod +x "$DESKTOP_FILE"
    info "Lanzador: $DESKTOP_FILE"

    command -v update-desktop-database &>/dev/null \
        && update-desktop-database "$DESKTOP_BASE" &>/dev/null || true
fi

if [[ "$HAS_NOTIFY" == true ]]; then
    notify-send "wine-exe-installer" "Instalación de '$APP_NAME' completada" 2>/dev/null || true
fi

echo ""
log "${GREEN}${BOLD}════════════════════════════════════════════════${NC}"
log "${GREEN}${BOLD}  ✔ Instalación completada: ${APP_NAME}${NC}"
log "${GREEN}${BOLD}════════════════════════════════════════════════${NC}"
log "  Prefijo:    $WINEPREFIX"
[[ -n "$INSTALLED_EXE" ]] && log "  Ejecutable: $INSTALLED_EXE"
[[ "$ICON_PATH" != "wine" ]] && log "  Icono:      $ICON_PATH"
[[ -n "$DESKTOP_FILE" ]] && log "  Lanzador:   $DESKTOP_FILE"
log "  Receta:     $RECIPE_FILE"
log "  Log:        $LOG_FILE"
log ""
log "  Lanza la app desde el menú o con:"
log "  WINEPREFIX=\"$WINEPREFIX\" wine \"$INSTALLED_EXE\""
log "${GREEN}${BOLD}════════════════════════════════════════════════${NC}"